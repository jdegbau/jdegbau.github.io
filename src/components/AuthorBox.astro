---
import { author } from '../data/author';
---
<div class="jdb-authorcard">
  <img src={author.profilePhoto} alt={author.name} loading="lazy" decoding="async" />
  <div>
    <div class="jdb-authorcard__name">{author.name}</div>
    <p>{author.bio}</p>
  </div>
  <a class="jdb-btn jdb-btn--outline jdb-btn--sm" href={author.cta.href}>{author.cta.text}</a>
</div>
