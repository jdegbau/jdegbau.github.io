---
import Image from './Image.astro';
const { post } = Astro.props;
---
<article class="jdb-post">
  <a href={post.url} class="jdb-post__media" aria-label={`Read ${post.title}`}>
    <Image
      src={post.featuredImage ?? '/assets/img/default-blog-hero.gif'}
      alt={post.title}
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="jdb-post__body">
    <div class="jdb-post__tags">
      {post.tags?.slice(0, 2).map((tag) => (
        <span class="jdb-tag jdb-tag--muted">{tag}</span>
      ))}
    </div>
    <h3><a href={post.url}>{post.title}</a></h3>
    <p>{post.excerpt || 'Read more on the blog.'}</p>
    <div class="jdb-post__meta">
      <time datetime={new Date(post.date).toISOString().split('T')[0]}> {new Date(post.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })} </time>
      <span>{post.readingTime ? `${post.readingTime} min read` : 'Read now'}</span>
    </div>
  </div>
</article>
