---
const { language = 'text', code = '' } = Astro.props;
---

<div class="jdb-code">
  <div class="jdb-code__bar">
    <span class="jdb-code__lang">{language}</span>
    <button class="jdb-code__copy" type="button" data-copy-code-block>
      <span class="jdb-icon jdb-icon--copy" aria-hidden="true"></span>
      <span class="jdb-code__label">Copy</span>
    </button>
  </div>
  <pre><code>{code}</code></pre>
</div>

<style>
  .jdb-code {
    margin: var(--jdb-s-7) 0;
    background: #08111f;
    border: 1px solid var(--jdb-line-strong);
    border-radius: var(--jdb-r-lg);
    overflow: hidden;
    box-shadow: var(--jdb-sh-md);
  }

  .jdb-code__bar {
    display: flex;
    align-items: center;
    gap: var(--jdb-s-3);
    padding: var(--jdb-s-3) var(--jdb-s-4);
    background: var(--jdb-navy-900);
    border-bottom: 1px solid var(--jdb-line);
  }

  .jdb-code__lang {
    font-family: var(--jdb-font-mono);
    font-size: var(--jdb-fs-xs);
    color: var(--jdb-fg-muted);
    margin-right: auto;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .jdb-code__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--jdb-font-mono);
    font-size: var(--jdb-fs-xs);
    color: var(--jdb-fg-muted);
    padding: 0.25rem 0.5rem;
    border-radius: var(--jdb-r-sm);
  }

  .jdb-code__copy:hover,
  .jdb-code__copy:focus {
    color: #fff;
    background: rgba(255,255,255,.06);
  }

  .jdb-code__copy .jdb-icon {
    width: 0.85em;
    height: 0.85em;
  }

  .jdb-code__label {
    pointer-events: none;
  }

  .jdb-code pre {
    margin: 0;
    padding: var(--jdb-s-5);
    overflow-x: auto;
    background: var(--jdb-navy-950);
    font-family: var(--jdb-font-mono);
    font-size: 0.95rem;
    line-height: 1.6;
    white-space: pre;
  }

  .jdb-code code {
    color: var(--jdb-fg-dim);
    font-family: inherit;
    white-space: pre;
  }
</style>

<script>
  const copyCodeBlockHandler = (event) => {
    const button = event.target.closest('[data-copy-code-block]');
    if (!button) return;

    const wrapper = button.closest('.jdb-code, .copyable-code-block, .code-block');
    const code = wrapper?.querySelector('code')?.textContent ?? '';
    if (!code) return;

    const labelNode = button.querySelector('.jdb-code__label') ?? button;
    const originalLabel = labelNode.textContent;

    navigator.clipboard.writeText(code.trim()).then(() => {
      labelNode.textContent = 'Copied';
      window.setTimeout(() => {
        labelNode.textContent = originalLabel;
      }, 2000);
    }).catch(() => {
      labelNode.textContent = 'Failed';
      window.setTimeout(() => {
        labelNode.textContent = originalLabel;
      }, 2000);
    });
  };

  if (!window.__codeBlockCopyBound) {
    window.__codeBlockCopyBound = true;
    document.addEventListener('click', copyCodeBlockHandler);
  }
</script>
