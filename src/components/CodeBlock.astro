---
const { language = 'text', code = '' } = Astro.props;
---

<div class="code-block">
  <div class="code-block__header">
    <span class="code-block__lang">{language}</span>
    <button class="code-block__button button is-primary is-rounded is-outlined is-small" type="button" data-copy-code-block>
      Copy
    </button>
  </div>
  <pre><code>{code}</code></pre>
</div>

<style>
  .code-block {
    margin: 1.5rem 0;
    border: 1px solid rgba(20, 20, 20, 0.08);
    border-radius: 0.75rem;
    overflow: hidden;
    background: #ffffff;
    box-shadow: 0 1px 3px rgba(20, 20, 20, 0.04);
  }

  .code-block__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.7rem 1rem;
    background: #f7f7f7;
    border-bottom: 1px solid rgba(20, 20, 20, 0.06);
  }

  .code-block__lang {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #5c5c5c;
  }

  .code-block__button {
    min-width: 4.5rem;
    justify-content: center;
    font-size: 0.8rem;
    padding: 0.35rem 0.8rem;
    border-color: rgba(21, 42, 73, 0.22);
    color: #152a49;
  }

  .code-block__button:hover,
  .code-block__button:focus {
    color: #152a49;
    border-color: #152a49;
  }

  .code-block pre {
    margin: 0;
    padding: 1rem 1.1rem 1.1rem;
    overflow-x: auto;
    background: #fff;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.95rem;
    line-height: 1.6;
    white-space: pre;
  }

  .code-block code {
    color: #141414;
    font-family: inherit;
    white-space: pre;
  }
</style>

<script>
  const copyCodeBlockHandler = (event) => {
    const button = event.target.closest('[data-copy-code-block]');
    if (!button) return;

    const wrapper = button.closest('.code-block');
    const code = wrapper?.querySelector('code')?.textContent ?? '';
    if (!code) return;

    const originalLabel = button.textContent;

    navigator.clipboard.writeText(code.trim()).then(() => {
      button.textContent = 'Copied';
      window.setTimeout(() => {
        button.textContent = originalLabel;
      }, 2000);
    }).catch(() => {
      button.textContent = 'Failed';
      window.setTimeout(() => {
        button.textContent = originalLabel;
      }, 2000);
    });
  };

  if (!window.__codeBlockCopyBound) {
    window.__codeBlockCopyBound = true;
    document.addEventListener('click', copyCodeBlockHandler);
  }
</script>
