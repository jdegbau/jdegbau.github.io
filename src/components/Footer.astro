---
import { author } from '../data/author';
---
<footer class="footer">
  <div class="columns is-reversed-mobile">
    <div class="column">
      <p>&copy; {new Date().getFullYear()} <a href="/">Joshua DeGrasse-Baumann</a></p>
      <a href="https://www.linkedin.com/in/jdegbau/" aria-label="Follow me on LinkedIn"><i class="fa-brands fa-linkedin fa-2x m-1"></i></a>
      <a href="https://github.com/jdegbau" aria-label="Follow me on GitHub"><i class="fa-brands fa-github fa-2x m-1"></i></a>
      <a href="https://www.instagram.com/jdegbau/" aria-label="Follow me on Instagram"><i class="fa-brands fa-instagram fa-2x m-1"></i></a>
      <a href="https://www.threads.net/@jdegbau" aria-label="Follow me on Threads"><i class="fa-brands fa-threads fa-2x m-1"></i></a>
      <a href="https://bsky.app/profile/jdegbau.com" aria-label="Follow me on Bluesky"><i class="fa-brands fa-bluesky fa-2x m-1"></i></a>
      <a href="https://x.com/jdegbau" aria-label="Follow me on 𝕏"><i class="fa-brands fa-x-twitter fa-2x m-1"></i></a>
    </div>
    <div class="column">
      <p class="subtitle is-4">Join My Newsletter!</p>
      <form method="post" action="https://sendfox.com/form/3odzg9/mp8k5q" class="sendfox-form" id="mp8k5q" data-async="true" data-recaptcha="true">
        <div class="columns is-mobile">
          <div class="column">
            <div class="control is-fullwidth">
              <input class="input" type="text" id="sendfox_form_name" placeholder="First Name" name="first_name" required />
            </div>
          </div>
          <div class="column">
            <div class="control is-fullwidth">
              <input class="input" type="text" id="sendfox_form_last_name" placeholder="Last Name" name="last_name" required />
            </div>
          </div>
        </div>
        <div class="columns is-mobile">
          <div class="column">
            <div class="control is-fullwidth">
              <input class="input" type="email" id="sendfox_form_email" placeholder="Email" name="email" required />
            </div>
          </div>
          <div class="column">
            <div class="control is-fullwidth">
              <button class="button is-primary is-fullwidth" type="submit">Sign Me Up!</button>
            </div>
          </div>
        </div>
        <div style="position: absolute; left: -5000px;" aria-hidden="true">
          <input type="text" name="a_password" tabindex="-1" value="" autocomplete="off" />
        </div>
      </form>
    </div>
  </div>
</footer>
