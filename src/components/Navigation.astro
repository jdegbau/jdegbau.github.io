---
const navPages = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: 'https://store.jdegbau.com/', label: 'Ready-Made GTM Templates', external: true },
  { href: '/contact/', label: 'Contact' },
];
const currentPath = Astro.url.pathname;
function isActive(href) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---
<style>
  .jdb-logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0;
    font-family: "JetBrains Mono", "SFMono-Regular", Consolas, monospace;
    font-variant-ligatures: contextual;
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: normal;
    text-decoration: none;
    white-space: nowrap;
  }

  .jdb-logo em,
  .jdb-logo b,
  .jdb-logo i {
    font-style: normal;
  }

  .jdb-logo em {
    color: var(--jdb-navy-600);
  }

  .jdb-logo b {
    color: var(--jdb-fg);
    font-weight: 600;
  }

  .jdb-logo i {
    color: var(--jdb-orange-500);
    margin-inline: 0.15em;
  }

  .jdb-logo__cursor {
    display: inline-block;
    width: 0.38em;
    height: 0.9em;
    background: currentColor;
    border-radius: 0.08em;
    transform: translateY(0.08em);
    animation: jdb-logo-cursor-blink 1s steps(1) infinite;
    opacity: 0.9;
  }

  .jdb-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 80;
    background: rgba(10, 21, 38, 0.76);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    transition:
      background 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  .jdb-header.is-scrolled {
    background: rgba(10, 21, 38, 0.9);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 12px 32px rgba(2, 6, 16, 0.22);
  }

  .jdb-header__inner {
    min-height: var(--jdb-header-h);
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: var(--jdb-s-5);
    transition: min-height 0.28s ease;
  }

  .jdb-header.is-scrolled .jdb-header__inner {
    min-height: calc(var(--jdb-header-h) - 8px);
  }

  @keyframes jdb-logo-cursor-blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
</style>

<header class="jdb-header" data-jdb-header>
  <div class="jdb-container jdb-header__inner">
    <a class="jdb-logo" href="/" aria-label="Joshua DeGrasse-Baumann home">
      <em>(</em><b>jdegbau</b><em>)</em><i> =&gt; </i><b>&#123;</b><span class="jdb-logo__cursor" aria-hidden="true"></span><b>&#125;</b>
    </a>

    <nav class="jdb-tabs" aria-label="Main navigation">
      <ul class="jdb-tabs__list">
        {navPages.map((item) => (
          <li>
            <a
              href={item.href}
              class="jdb-tabs__link"
              aria-current={isActive(item.href) ? 'page' : undefined}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="jdb-header__actions">
      <slot />
      <button class="jdb-menu-btn" type="button" aria-label="Open navigation" data-jdb-menu-btn>
        <span class="jdb-icon jdb-icon--menu" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="jdb-drawer" data-jdb-drawer>
  <div class="jdb-drawer__scrim" data-jdb-close></div>
  <aside class="jdb-drawer__panel" aria-label="Mobile navigation panel">
    <div class="jdb-drawer__head">
      <a class="jdb-logo" href="/" aria-label="Joshua DeGrasse-Baumann home">
        <em>(</em><b>jdegbau</b><em>)</em><i> =&gt; </i><b>&#123;</b><span class="jdb-logo__cursor" aria-hidden="true"></span><b>&#125;</b>
      </a>
      <button class="jdb-drawer__close" type="button" aria-label="Close navigation" data-jdb-close>
        <span class="jdb-icon jdb-icon--close" aria-hidden="true"></span>
      </button>
    </div>
    <ul class="jdb-drawer__list">
      {navPages.map((item) => (
        <li>
          <a
            href={item.href}
            class="jdb-drawer__link"
            aria-current={isActive(item.href) ? 'page' : undefined}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="jdb-drawer__foot">
      <slot />
    </div>
  </aside>
</div>

<script>
  const drawer = document.querySelector('[data-jdb-drawer]');
  const menuButton = document.querySelector('[data-jdb-menu-btn]');
  const closeButtons = document.querySelectorAll('[data-jdb-close]');
  const header = document.querySelector('[data-jdb-header]');

  if (drawer && menuButton) {
    const toggleDrawer = () => {
      drawer.classList.toggle('is-open');
      document.body.classList.toggle('jdb-noscroll', drawer.classList.contains('is-open'));
    };

    menuButton.addEventListener('click', toggleDrawer);
    closeButtons.forEach((button) => button.addEventListener('click', toggleDrawer));
  }

  if (header) {
    const updateHeaderState = () => {
      const currentScrollY = window.scrollY;
      header.classList.toggle('is-scrolled', currentScrollY > 12);
    };

    window.addEventListener('scroll', () => {
      window.requestAnimationFrame(updateHeaderState);
    }, { passive: true });

    updateHeaderState();
  }
</script>
