---
import Logotype from './Logotype.astro';
// Order matters: the first and last items are the ones people remember, so
// the guides lead and Contact (the main next step) closes the list and is
// styled as a button. Keep this list short.
const navPages = [
  { href: '/blog/', label: 'Blog' },
  { href: '/seo-helpline/', label: 'SEO Helpline' },
  { href: '/about/', label: 'About' },
  { href: 'https://store.jdegbau.com/', label: 'GTM Templates', external: true },
  { href: '/contact/', label: 'Contact', cta: true },
];
const currentPath = Astro.url.pathname;
function isActive(href) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---
<style>
  .jdb-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 80;
    background: rgba(10, 21, 38, 0.76);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 rgba(0, 0, 0, 0);
    transition:
      background 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  .jdb-header.is-scrolled {
    background: rgba(10, 21, 38, 0.9);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 12px 32px rgba(2, 6, 16, 0.22);
  }

  .jdb-header__inner {
    min-height: var(--jdb-header-h);
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: var(--jdb-s-5);
    transition: min-height 0.28s ease;
  }

  .jdb-header.is-scrolled .jdb-header__inner {
    min-height: calc(var(--jdb-header-h) - 8px);
  }

</style>

<header class="jdb-header" data-jdb-header>
  <div class="jdb-container jdb-header__inner">
    <Logotype />

    <nav class="jdb-tabs" aria-label="Main navigation">
      <ul class="jdb-tabs__list">
        {navPages.map((item) => (
          <li class:list={[{ 'jdb-tabs__item--cta': item.cta }]}>
            <a
              href={item.href}
              class:list={['jdb-tabs__link', { 'jdb-tabs__link--cta': item.cta }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
            >
              {item.label}
              {item.external && (
                <>
                  <span class="jdb-icon jdb-icon--external jdb-tabs__ext" aria-hidden="true"></span>
                  <span class="jdb-sr-only">(opens in a new tab)</span>
                </>
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="jdb-header__actions">
      <slot />
      <button class="jdb-menu-btn" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="jdb-drawer-panel" data-jdb-menu-btn>
        <span class="jdb-icon jdb-icon--menu" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div class="jdb-drawer" data-jdb-drawer>
  <div class="jdb-drawer__scrim" data-jdb-close></div>
  <aside class="jdb-drawer__panel" id="jdb-drawer-panel" aria-label="Mobile navigation panel">
    <div class="jdb-drawer__head">
      <Logotype />
      <button class="jdb-drawer__close" type="button" aria-label="Close navigation" data-jdb-close>
        <span class="jdb-icon jdb-icon--close" aria-hidden="true"></span>
      </button>
    </div>
    <ul class="jdb-drawer__list">
      {navPages.map((item) => (
        <li>
          <a
            href={item.href}
            class="jdb-drawer__link"
            aria-current={isActive(item.href) ? 'page' : undefined}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            {item.label}
            {item.external && (
              <>
                <span class="jdb-icon jdb-icon--external jdb-tabs__ext" aria-hidden="true"></span>
                <span class="jdb-sr-only">(opens in a new tab)</span>
              </>
            )}
          </a>
        </li>
      ))}
    </ul>
    <div class="jdb-drawer__foot">
      <slot />
    </div>
  </aside>
</div>

<script>
  const drawer = document.querySelector('[data-jdb-drawer]');
  const menuButton = document.querySelector('[data-jdb-menu-btn]');
  const closeButtons = document.querySelectorAll('[data-jdb-close]');
  const header = document.querySelector('[data-jdb-header]');

  if (drawer && menuButton) {
    const closeButton = drawer.querySelector('button[data-jdb-close]');

    const setDrawer = (open) => {
      drawer.classList.toggle('is-open', open);
      document.body.classList.toggle('jdb-noscroll', open);
      menuButton.setAttribute('aria-expanded', String(open));
      // Move focus into the panel on open and back to the trigger on close,
      // so keyboard users never lose their place.
      if (open) closeButton?.focus();
      else menuButton.focus();
    };

    menuButton.addEventListener('click', () => setDrawer(true));
    closeButtons.forEach((button) => button.addEventListener('click', () => setDrawer(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && drawer.classList.contains('is-open')) setDrawer(false);
    });
  }

  if (header) {
    const updateHeaderState = () => {
      const currentScrollY = window.scrollY;
      header.classList.toggle('is-scrolled', currentScrollY > 12);
    };

    window.addEventListener('scroll', () => {
      window.requestAnimationFrame(updateHeaderState);
    }, { passive: true });

    updateHeaderState();
  }
</script>
