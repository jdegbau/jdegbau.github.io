---
const { date, readingTime, url } = Astro.props;
---
<style>
  .post-meta {
    position: sticky;
    top: var(--jdb-header-h);
    z-index: 70;
    border-top: 1px solid var(--jdb-line);
    border-bottom: 1px solid var(--jdb-line);
    background: rgba(10, 21, 38, 0.82);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
    box-shadow: 0 1px 0 rgba(255,255,255,0.05);
  }

  .post-meta__row {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    width: 100%;
  }

  .post-meta__group,
  .post-meta__share {
    flex: 1 1 50%;
    min-width: 0;
  }

  .post-meta__group {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    border-right: 1px solid var(--jdb-line);
  }

  .post-meta__item {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 0;
    min-height: 3rem;
    padding: var(--jdb-s-3) var(--jdb-s-4);
    font-family: var(--jdb-font-mono);
    font-size: var(--jdb-fs-xs);
    color: var(--jdb-fg-muted);

  }

  .post-meta__item + .post-meta__item {
    border-left: 1px solid var(--jdb-line);
  }

  .post-meta__share {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--jdb-s-3);
    padding: var(--jdb-s-3) var(--jdb-s-4);
    flex-wrap: wrap;
  }

  .post-meta__share-label {
    font-family: var(--jdb-font-mono);
    font-size: var(--jdb-fs-xs);
    font-weight: var(--jdb-fw-semibold);
    color: var(--jdb-fg-muted);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .post-meta__share a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: var(--jdb-orange-400);
    text-decoration: none;
    border-radius: var(--jdb-r-sm);
    transition: background var(--jdb-t-fast), color var(--jdb-t-fast);
  }

  .post-meta__share a:hover,
  .post-meta__share a:focus-visible {
    background: rgba(255,255,255,.06);
    color: #fff;
  }

  .post-meta__progress {
    position: relative;
    width: 100%;
    height: 4px;
    background: rgba(255,255,255,.06);
    overflow: hidden;
  }

  .post-meta__progress-bar {
    position: absolute;
    left: 50%;
    top: 0;
    height: 100%;
    width: 0;
    background: linear-gradient(to right, var(--jdb-orange-500), var(--jdb-navy-800), var(--jdb-orange-500));
    transform: translateX(-50%);
  }

  @media (max-width: 48rem) {
    .post-meta {
      top: calc(var(--jdb-header-h) - 1px);
      border-top: none;
      margin-top: -1px;
    }

    .post-meta__group {
      width: 100%;
      border-right: none;
      border-bottom: 1px solid var(--jdb-line);
    }

    .post-meta__item {
      flex-basis: 50%;
    }

    .post-meta__item + .post-meta__item {
      border-left: 1px solid var(--jdb-line);
    }

    .post-meta__share {
      width: 100%;
    }
  }
</style>
<div class="post-meta" role="group" aria-label="Post metadata">
  <div class="post-meta__row">
    <div class="post-meta__group">
      <div class="post-meta__item">
        <span><i class="fa-solid fa-calendar-days" aria-hidden="true"></i> {date}</span>
      </div>
      <div class="post-meta__item">
        <span><i class="fa-solid fa-clock" aria-hidden="true"></i> {readingTime} min read</span>
      </div>
    </div>

    <div class="post-meta__share">
      <span class="post-meta__share-label">Share:</span>
      <a href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(Astro.props.title)}&url=${url}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X">
        <i class="fa-brands fa-x-twitter" aria-hidden="true"></i>
      </a>
      <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${url}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
        <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
      </a>
      <a href={`mailto:?subject=${encodeURIComponent(Astro.props.title)}&body=${url}`} aria-label="Share by email">
        <i class="fa-solid fa-envelope" aria-hidden="true"></i>
      </a>
    </div>
  </div>

  <div class="post-meta__progress" aria-hidden="true">
    <div class="post-meta__progress-bar" id="progress-bar"></div>
  </div>
</div>
