---
---
<div class="jdb-search-trigger-wrap">
  <button
    type="button"
    class="jdb-search-trigger"
    data-jdb-search-trigger
    aria-expanded="false"
    aria-controls="jdb-searchpanel"
  >
    <span class="jdb-icon jdb-icon--search" aria-hidden="true"></span>
    Search
    <kbd>/</kbd>
  </button>
</div>

<div class="jdb-searchpanel" id="jdb-searchpanel" data-jdb-searchpanel>
  <div class="jdb-container">
    <div class="jdb-searchpanel__inner">
      <span class="jdb-icon jdb-icon--search" aria-hidden="true"></span>
      <label class="jdb-sr-only" for="search-input">Search posts</label>
      <input type="search" id="search-input" aria-label="Search posts" aria-controls="results-container" placeholder="Search posts..." />
    </div>
    <ul id="results-container" class="jdb-searchpanel__results" aria-live="polite" aria-atomic="true"></ul>
  </div>
</div>

<script>
  const searchPanel = document.querySelector('[data-jdb-searchpanel]');
  const searchTrigger = document.querySelector('[data-jdb-search-trigger]');
  const searchInput = document.getElementById('search-input');
  const resultsContainer = document.getElementById('results-container');

  if (searchPanel && searchTrigger && searchInput && resultsContainer) {
    searchTrigger.addEventListener('click', () => {
      const isOpen = searchPanel.classList.toggle('is-open');
      searchTrigger.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) {
        searchInput.focus();
      }
    });

    let posts = [];

    async function loadPosts() {
      if (posts.length > 0) return posts;
      try {
        const response = await fetch('/search.json');
        if (!response.ok) throw new Error('Failed to load search data');
        posts = await response.json();
      } catch (error) {
        console.error(error);
        posts = [];
      }
      return posts;
    }

    function formatResult(post) {
      return `
        <li class="jdb-searchpanel__result">
          <a href="${post.permalink}">
            <strong>${post.title}</strong>
            <span>${post.excerpt || ''}</span>
          </a>
        </li>
      `;
    }

    function renderResults(results) {
      if (!results.length) {
        resultsContainer.innerHTML = `
          <li class="jdb-searchpanel__result jdb-searchpanel__result--empty">
            <strong>Oops! You stumped me!</strong>
            <span>No matching results found.</span>
          </li>
        `;
        return;
      }

      resultsContainer.innerHTML = results.map(formatResult).join('');
    }

    async function handleSearch(event) {
      const query = (event.target.value || '').trim().toLowerCase();
      await loadPosts();

      if (!query) {
        resultsContainer.innerHTML = '';
        return;
      }

      const filtered = posts.filter((post) => {
        const title = (post.title || '').toLowerCase();
        const excerpt = (post.excerpt || '').toLowerCase();
        return title.includes(query) || excerpt.includes(query);
      });

      renderResults(filtered.slice(0, 8));
    }

    searchInput.addEventListener('input', handleSearch);
  }
</script>
