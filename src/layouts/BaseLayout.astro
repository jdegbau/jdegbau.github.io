---
import SEO from '../components/SEO.astro';
import Navigation from '../components/Navigation.astro';
import Search from '../components/Search.astro';
import Footer from '../components/Footer.astro';
const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  noindex,
  date,
  modified,
  seoTitle,
  type,
  authorName,
  keywords,
  schema,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class="has-navbar-fixed-top">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <style>
      /* Critical CSS: keeps the first paint on-brand while main.css loads. */
      .skip-nav-link {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 31;
        display: inline-block;
        width: auto;
        max-width: calc(100vw - 1rem);
        padding: .5rem .75rem;
        margin: 0;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
        background: #f0f0f0;
        color: #0f0f0f;
        border-radius: 0 0 .25rem .25rem;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-120%);
        transition: transform .2s ease, opacity .2s ease, visibility .2s ease;
      }

      /* Bring into view when focused via Keyboard / Tab */
      .skip-nav-link:focus,
      .skip-nav-link:focus-visible {
        clip: auto;
        clip-path: none;
        overflow: visible;
        width: auto;
        height: auto;
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
      }
      html, body {
        background: #0a1526;
        color: #e8ecf4;
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 16px;
        line-height: 1.5;
        margin: 0;
        padding: 0;
      }
      body {
        padding-top: 64px;
      }
    </style>
    <link rel="preload" href="/assets/fonts/Inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/JetBrains_Mono.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/css/main.css" />
    <link rel="stylesheet" href="/assets/css/copy-code-block.css" />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
      date={date}
      modified={modified}
      seoTitle={seoTitle}
      type={type}
      authorName={authorName}
      keywords={keywords}
      schema={schema}
    />
    <script dangerouslySetInnerHTML={{ __html: `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','GTM-NM6JBXF');` }} />
  </head>
  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NM6JBXF" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <a href="#main-content" class="skip-nav-link">Skip to main content</a>
    <slot name="nav">
      <Navigation>
        <Search />
      </Navigation>
    </slot>
    <main id="main-content" role="main">
      <slot />
    </main>
    <slot name="footer">
      <Footer />
    </slot>
    <script src="/assets/js/mobile-nav.min.js" defer></script>
    <script src="/assets/js/copy-code-block.min.js" defer></script>
    <script src="/assets/js/copy-code-block-inline.js" defer></script>
    <script src="/assets/js/progress-bar.min.js" defer></script>
    <script src="https://instant.page/5.1.0" type="module" integrity="sha384-by67kQnR+pyfy8yWP4kPO12fHKRLHZPfEsiSXR8u2IKcTdxD805MGUXBzVPnkLHw" defer></script>
    <script>
      (() => {
        try {
          const imgs = document.querySelectorAll('img:not([loading])');
          imgs.forEach((img) => {
            if (img.getAttribute('loading') === 'eager') return;
            if (img.getAttribute('fetchpriority') === 'high') return;
            img.setAttribute('loading', 'lazy');
            img.setAttribute('decoding', 'async');
          });
        } catch (e) {}
      })();
    </script>
  </body>
</html>
