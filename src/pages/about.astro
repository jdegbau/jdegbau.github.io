---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Logos from '../components/Logos.astro';
import BlogCard from '../components/BlogCard.astro';
import { getAllPosts } from '../lib/posts';

const posts = getAllPosts().slice(0, 3);
const seoTitle = "About Joshua DeGrasse-Baumann";
const description = 'About Joshua DeGrasse-Baumann, including his work in SEO, analytics, and development.';
---
<BaseLayout seoTitle={seoTitle} description={description}>
  <Hero variant="intro" containerWidth="narrow">
    <span class="jdb-eyebrow">about</span>
    <h1>Hello. I’m Josh.</h1>
    <p class="jdb-hero__lede">
      I’m an SEO strategist, data enthusiast, and developer focused on helping teams turn messy information into useful decisions and better digital experiences.
    </p>
  </Hero>

  <section class="jdb-section">
    <div class="jdb-container jdb-container--narrow">
      <div class="jdb-prose">
        <p>I help businesses unlock their digital potential through strategic SEO, data analysis, and web development. My work sits at the intersection of search visibility, analytics quality, and practical implementation.</p>
        <p>At the moment, I work as a Content Marketing Strategist at Ellsworth Adhesives, where I focus on connecting search, analytics, and content strategy to business outcomes and operational clarity.</p>
        <p>Before that, I spent time helping teams improve technical SEO, digital analytics, and content systems. I’m especially interested in the way clean data, thoughtful planning, and good web execution can compound over time.</p>
      </div>
    </div>
  </section>

  <Logos />

  <section class="jdb-section">
    <div class="jdb-container">
      <div class="jdb-section__head">
        <span class="jdb-eyebrow">what I do</span>
        <h2 class="jdb-section__title">A practical mix of strategy and execution</h2>
      </div>
      <div class="jdb-grid jdb-grid--2">
        <article class="jdb-service">
          <div class="jdb-service__icon"><span class="jdb-icon jdb-icon--search" aria-hidden="true"></span></div>
          <h3>SEO Strategy</h3>
          <p>Technical audits, content planning, and implementation roadmaps for teams that want sustainable search growth.</p>
        </article>
        <article class="jdb-service">
          <div class="jdb-service__icon"><span class="jdb-icon jdb-icon--branch" aria-hidden="true"></span></div>
          <h3>Analytics</h3>
          <p>Google Analytics and GTM setup, event design, and reporting systems that help teams understand what’s really working.</p>
        </article>
        <article class="jdb-service">
          <div class="jdb-service__icon"><span class="jdb-icon jdb-icon--check" aria-hidden="true"></span></div>
          <h3>Web Development</h3>
          <p>High-quality implementation for sites that need clarity, performance, and better long-term maintainability.</p>
        </article>
        <article class="jdb-service">
          <div class="jdb-service__icon"><span class="jdb-icon jdb-icon--external" aria-hidden="true"></span></div>
          <h3>Programmatic SEO</h3>
          <p>Systems that pair data with structured content so search strategies can scale without losing quality.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="jdb-section">
    <div class="jdb-container">
      <div class="jdb-section__head">
        <span class="jdb-eyebrow">experience</span>
        <h2 class="jdb-section__title">Where I’ve been</h2>
      </div>
      <ul class="jdb-timeline">
        <li class="jdb-timeline__item jdb-timeline__item--current">
          <div class="jdb-timeline__role">Content Marketing Strategist</div>
          <div class="jdb-timeline__meta">
            <strong>Ellsworth Adhesives</strong>
            <span class="jdb-badge"><span class="jdb-badge__dot"></span> Current</span>
          </div>
          <p>Supporting digital strategy and measurement efforts that connect website performance, customer experience, and commercial goals.</p>
        </li>
        <li class="jdb-timeline__item">
          <div class="jdb-timeline__role">SEO &amp; Digital Strategy</div>
          <div class="jdb-timeline__meta">
            <strong>Rocket Clicks</strong>
            <span class="jdb-badge"><span class="jdb-badge__dot"></span> Prior</span>
          </div>
          <p>Delivered SEO solutions and digital marketing strategy for diverse client portfolios with a strong focus on measurement and implementation.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="jdb-section">
    <div class="jdb-container">
      <div class="jdb-section__head">
        <span class="jdb-eyebrow">recent articles</span>
        <h2 class="jdb-section__title">A few recent notes</h2>
      </div>
      <div class="jdb-postgrid">
        {posts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
