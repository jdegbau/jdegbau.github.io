---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Logos from '../components/Logos.astro';
import BlogCard from '../components/BlogCard.astro';
import CallToAction from '../components/CallToAction.astro';
import { getAllPosts } from '../lib/posts';

const posts = (await getAllPosts()).slice(0, 3);
const seoTitle = "About Joshua DeGrasse-Baumann";
const description = 'About Joshua DeGrasse-Baumann, including his work in content strategy, data visualization, measurement strategy, and SEO.';
---
<BaseLayout seoTitle={seoTitle} description={description}>
  <Hero variant="intro" containerWidth="narrow">
    <span class="jdb-eyebrow">about</span>
    <h1>Hello. I’m Josh.</h1>
    <p class="jdb-hero__lede">
      I’m a content strategist focused on data visualization and measurement strategy. I help teams decide what to make, how to measure it, and how to explain the results.
    </p>
  </Hero>

  <section class="jdb-section">
    <div class="jdb-container jdb-container--narrow">
      <div class="jdb-prose">
        <p>My work sits where content, data, and decision-making meet. I build content strategies grounded in audience needs, measurement plans that capture the signals that matter, and visualizations that make performance easy to understand. SEO is still part of the toolkit, as one of several ways content earns attention.</p>
        <p>At the moment, I work as a Content Marketing Strategist at Ellsworth Adhesives, where I focus on connecting content strategy, measurement, and reporting to business outcomes.</p>
        <p>Before that, I spent years in agency SEO and analytics roles, helping clients improve search visibility, digital analytics, and content systems. That background shapes how I approach content today: start with a clear question, measure honestly, and show the answer plainly.</p>
      </div>
    </div>
  </section>

  <Logos />

  <section class="jdb-section">
    <div class="jdb-container">
      <div class="jdb-section__head">
        <span class="jdb-eyebrow">what I do</span>
        <h2 class="jdb-section__title">A practical mix of strategy and execution</h2>
      </div>
      <div class="jdb-grid jdb-grid--2">
        <article class="jdb-service">
          <div class="jdb-service__icon"><span class="jdb-icon jdb-icon--check" aria-hidden="true"></span></div>
          <h3>Content Strategy</h3>
          <p>Content audits, editorial planning, and frameworks that help teams publish fewer, better pieces with a clear purpose.</p>
        </article>
        <article class="jdb-service">
          <div class="jdb-service__icon"><span class="jdb-icon jdb-icon--external" aria-hidden="true"></span></div>
          <h3>Data Visualization</h3>
          <p>Charts, dashboards, and reports built for the audience reading them, with the right chart for each question.</p>
        </article>
        <article class="jdb-service">
          <div class="jdb-service__icon"><span class="jdb-icon jdb-icon--branch" aria-hidden="true"></span></div>
          <h3>Measurement Strategy</h3>
          <p>KPI definitions, measurement plans, and GA4 and GTM event design that help teams understand what’s really working.</p>
        </article>
        <article class="jdb-service">
          <div class="jdb-service__icon"><span class="jdb-icon jdb-icon--search" aria-hidden="true"></span></div>
          <h3>SEO</h3>
          <p>Technical audits and search-informed content planning for teams that want sustainable organic visibility.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="jdb-section jdb-section--raised">
    <div class="jdb-container">
      <div class="jdb-section__head">
        <span class="jdb-eyebrow">how I think about content</span>
        <h2 class="jdb-section__title">Four principles behind the work</h2>
      </div>
      <div class="jdb-grid jdb-grid--2">
        <article class="jdb-service">
          <h3>Start with the audience’s questions</h3>
          <p>The best content answers what people are already asking. Research comes before writing, every time.</p>
        </article>
        <article class="jdb-service">
          <h3>Publish fewer, better pieces</h3>
          <p>One genuinely useful guide beats ten thin posts. Depth, original insight, and clear visuals are what earn attention and links.</p>
        </article>
        <article class="jdb-service">
          <h3>Measure what matters</h3>
          <p>Decide what success looks like before you publish, then track it honestly, even when the numbers aren’t flattering.</p>
        </article>
        <article class="jdb-service">
          <h3>Show the data plainly</h3>
          <p>A report is only useful if people understand it. The right chart, clearly labeled, beats a crowded dashboard.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="jdb-section">
    <div class="jdb-container">
      <div class="jdb-section__head">
        <span class="jdb-eyebrow">experience</span>
        <h2 class="jdb-section__title">Where I’ve been</h2>
      </div>
      <ul class="jdb-timeline">
        <li class="jdb-timeline__item jdb-timeline__item--current">
          <div class="jdb-timeline__role">Content Marketing Strategist</div>
          <div class="jdb-timeline__meta">
            <strong>Ellsworth Adhesives</strong>
            <span class="jdb-badge"><span class="jdb-badge__dot"></span> Current</span>
          </div>
          <p>Leading content strategy and digital marketing efforts that support brand growth, customer education, and measurable demand generation.</p>
        </li>
        <li class="jdb-timeline__item">
          <div class="jdb-timeline__role">Lead SEO Strategist</div>
          <div class="jdb-timeline__meta">
            <strong>Fire&amp;Spark</strong>
            <span class="jdb-badge"><span class="jdb-badge__dot"></span> Prior</span>
          </div>
          <p>Built SEO strategies, analytics systems, and digital growth programs that improved visibility, measurement, and cross-functional execution.</p>
        </li>
        <li class="jdb-timeline__item">
          <div class="jdb-timeline__role">SEO Manager &amp; Analytics Specialist</div>
          <div class="jdb-timeline__meta">
            <strong>Rocket Clicks</strong>
            <span class="jdb-badge"><span class="jdb-badge__dot"></span> Prior</span>
          </div>
          <p>Delivered SEO solutions and digital marketing strategy for diverse client portfolios with a strong focus on measurement and implementation.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="jdb-section">
    <div class="jdb-container">
      <div class="jdb-section__head">
        <span class="jdb-eyebrow">recent articles</span>
        <h2 class="jdb-section__title">A few recent notes</h2>
      </div>
      <div class="jdb-postgrid">
        {posts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
      <CallToAction
        prompt="let's talk"
        title="Want to work through a content or measurement problem together?"
        text="Book a focused one-hour call, or send a short note about what you’re working on."
        primary={{ href: '/seo-helpline/', label: 'Book a consultation' }}
        secondary={{ href: '/contact/', label: 'Get in touch' }}
      />
    </div>
  </section>

</BaseLayout>
