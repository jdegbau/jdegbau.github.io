---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import Hero from '../../components/Hero.astro';
import ChartTypeAssessment from '../../components/ChartTypeAssessment.astro';
import ChartPickerQuiz from '../../components/ChartPickerQuiz.astro';
import DataStoryBestPractices from '../../components/DataStoryBestPractices.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import PostMeta from '../../components/PostMeta.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import QuickCompareMatrix from '../../components/QuickCompareMatrix.astro';
import PostSeriesNav from '../../components/PostSeriesNav.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import CallToAction from '../../components/CallToAction.astro';
import { render } from 'astro:content';
import { getAllPosts, getHeadings, getPostBySlug } from '../../lib/posts';

export async function getStaticPaths() {
  return (await getAllPosts()).flatMap((post) => {
    const paths = [{ params: { slug: post.slug } }];
    if (post.legacySlug !== post.slug) {
      paths.push({ params: { slug: post.legacySlug } });
    }
    return paths;
  });
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug);

if (!post) {
  throw new Error(`Blog post not found: ${slug}`);
}

if (slug !== post.slug) {
  return Astro.redirect(post.url, 301);
}

const { Content, headings: renderedHeadings } = await render(post.entry);
const headings = getHeadings(post, renderedHeadings);
const seoTitle = post.seoTitle ?? post.title;
const description = post.excerpt;
const canonical = post.url;
const keywords = post.keywords.length ? post.keywords : post.tags;
const siteUrl = 'https://jdegbau.com';
const pageUrl = `${siteUrl}${canonical}`;
const wasUpdated = post.updated !== post.date;
const formatDate = (value: string, month: 'short' | 'long') =>
  new Date(`${value}T12:00:00Z`).toLocaleDateString('en-US', { month, day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// The data-viz guide gets interactive extras around its markdown.
const isDataVizGuide = post.slug === 'seo-data-visualization-guide';
// Post FAQs come from front matter; the same items drive the accordion and the FAQPage schema.
const faqTitle = isDataVizGuide ? undefined : 'Frequently asked questions';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${pageUrl}#article`,
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
      url: pageUrl,
      headline: post.title,
      description,
      inLanguage: 'en',
      image: `${siteUrl}${post.ogImage}`,
      datePublished: post.date,
      dateModified: post.updated,
      wordCount: post.entry.body?.trim().split(/\s+/).length,
      keywords: keywords.length ? keywords.join(', ') : undefined,
      author: { '@type': 'Person', '@id': `${siteUrl}/#person`, name: 'Joshua DeGrasse-Baumann', url: `${siteUrl}/about/` },
      publisher: { '@type': 'Person', '@id': `${siteUrl}/#person`, name: 'Joshua DeGrasse-Baumann' },
      isPartOf: { '@type': 'Blog', '@id': `${siteUrl}/blog/#blog`, name: 'jdegbau blog', url: `${siteUrl}/blog/` },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog/` },
        { '@type': 'ListItem', position: 3, name: post.title, item: pageUrl },
      ],
    },
    ...(post.faq.length
      ? [
          {
            '@type': 'FAQPage',
            '@id': `${pageUrl}#faq`,
            mainEntity: post.faq.map((item) => ({
              '@type': 'Question',
              name: item.question,
              acceptedAnswer: { '@type': 'Answer', text: item.answer },
            })),
          },
        ]
      : []),
  ],
};
---
<BaseLayout
  seoTitle={seoTitle}
  description={description}
  image={post.ogImage}
  imageAlt={post.title}
  date={post.date}
  modified={post.updated}
  schema={schema}
  canonical={canonical}
  keywords={keywords}
  type="article"
  authorName="Joshua DeGrasse-Baumann"
>
  <article>
    <Hero
      variant="full"
      class="jdb-hero--blog"
      backgroundImage={post.featuredImage}
    >
      <nav class="jdb-crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="jdb-crumbs__sep" aria-hidden="true">/</span>
        <a href="/blog/">Blog</a>
      </nav>
      <h1>{post.title}</h1>
      <div class="jdb-postheader__meta">
        <span class="jdb-postheader__metaitem">
          <span class="jdb-icon jdb-icon--check" aria-hidden="true"></span>
          <time datetime={post.date}>{formatDate(post.date, 'short')}</time>
        </span>
        <span class="jdb-postheader__metaitem">
          <span class="jdb-icon jdb-icon--branch" aria-hidden="true"></span>
          {post.readingTime ? `${post.readingTime} min read` : 'Read now'}
        </span>
      </div>
    </Hero>

    <PostMeta
      date={formatDate(post.date, 'long')}
      updated={wasUpdated ? formatDate(post.updated, 'long') : undefined}
      readingTime={post.readingTime ? `${post.readingTime} min read` : 'Read now'}
      url={`https://jdegbau.com${canonical}`}
      title={post.title}
    />

    <section class="jdb-section">
      <div class="jdb-container jdb-container--wide">
        <div class="jdb-blog-layout">
          <aside class="jdb-blog-layout__toc">
            <TableOfContents items={headings} />
          </aside>

          <div class="jdb-prose jdb-blog-layout__content">
            {isDataVizGuide && <ChartPickerQuiz />}
            {isDataVizGuide && <QuickCompareMatrix />}
            <Content />
            {isDataVizGuide && <DataStoryBestPractices />}
            {post.faq.length > 0 && <FAQAccordion items={post.faq} title={faqTitle} />}
            {isDataVizGuide && <ChartTypeAssessment />}
            {post.series && <PostSeriesNav series={post.series} current={post.slug} />}
            <CallToAction
              prompt="found this useful?"
              title="Get the next guide in your inbox"
              text="Practical notes on content strategy, data visualization, measurement, and SEO, sent when they’re published."
              primary={{ href: '#newsletter', label: 'Subscribe by email' }}
              secondary={{ href: '/seo-helpline/', label: 'Book a consultation' }}
              headingLevel="h2"
            />
            <RelatedPosts current={post.slug} />
          </div>
        </div>
      </div>
    </section>

    <section class="jdb-section jdb-section--tight">
      <div class="jdb-container jdb-container--narrow">
        <AuthorBox />
      </div>
    </section>
  </article>

</BaseLayout>

<style>
  .jdb-blog-layout {
    display: grid;
    grid-template-columns: minmax(0, 270px) minmax(0, 1fr);
    gap: var(--jdb-s-7);
    align-items: start;
  }

  .jdb-blog-layout__toc {
    position: sticky;
    top: calc(var(--jdb-header-h) + var(--jdb-postmeta-h) + .5rem);
    align-self: start;
  }

  .jdb-blog-layout__content {
    min-width: 0;
  }

  @media (max-width: 64rem) {
    .jdb-blog-layout {
      grid-template-columns: 1fr;
    }

    .jdb-blog-layout__toc {
      position: static;
      top: auto;
    }
  }
</style>
