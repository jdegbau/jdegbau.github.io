---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import Search from '../../components/Search.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getAllPosts } from '../../lib/posts';

const posts = getAllPosts();
const seoTitle = "Josh's Blog";
const description = 'Check out interesting insights, tips, and guides related to SEO, data analytics, and automation written by Joshua DeGrasse-Baumann.';
---
<BaseLayout
  seoTitle={seoTitle}
  description={description}
  canonical="/blog/"
  image="/assets/img/default-blog-hero.gif"
>
  <nav slot="nav">
    <Navigation>
      <Search />
    </Navigation>
  </nav>

  <section class="jdb-hero jdb-hero--intro">
    <div class="jdb-container jdb-container--wide">
      <span class="jdb-eyebrow">blog</span>
      <h1>{seoTitle}</h1>
      <p class="jdb-hero__lede">{description}</p>
    </div>
  </section>

  <section class="jdb-section">
    <div class="jdb-container">
      <div class="jdb-postgrid">
        {posts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
