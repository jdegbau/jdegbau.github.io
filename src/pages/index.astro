---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logos from '../components/Logos.astro';
import BlogCard from '../components/BlogCard.astro';
import { getAllPosts } from '../lib/posts';

const seoTitle = 'Joshua DeGrasse-Baumann | SEO, Data, and Development';
const description = 'Joshua DeGrasse-Baumann is an SEO consultant and data enthusiast. Learn more about Josh and how he can help your business.';
const posts = getAllPosts();
const featuredPosts = posts.slice(0, 3);
const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://jdegbau.com/#person',
      name: 'Joshua DeGrasse-Baumann',
      givenName: 'Joshua',
      familyName: 'DeGrasse-Baumann',
      alternateName: ['Josh', 'jdegbau'],
      url: 'https://jdegbau.com/',
      image: 'https://jdegbau.com/assets/img/joshua-degrasse-baumann.JPG',
      description: 'SEO strategist and data enthusiast specializing in Google Analytics, Google Tag Manager, marketing measurement, and SEO strategy.',
      jobTitle: 'Lead SEO Strategist',
      worksFor: {
        '@type': 'Organization',
        '@id': 'https://www.fireandspark.com/#organization',
        name: 'Fire&Spark',
        url: 'https://www.fireandspark.com/',
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://jdegbau.com/#website',
      url: 'https://jdegbau.com/',
      name: 'Joshua DeGrasse-Baumann | SEO, Data, and Development',
      alternateName: 'jdegbau',
      inLanguage: 'en',
      publisher: { '@id': 'https://jdegbau.com/#person' },
    },
  ],
};
---
<BaseLayout seoTitle={seoTitle} description={description}>
  <section class="jdb-hero jdb-hero--home">
    <div class="jdb-container">
      <div class="jdb-hero__inner">
        <div class="jdb-hero__kicker">
          <span class="jdb-icon jdb-icon--check" aria-hidden="true"></span>
          Joshua DeGrasse-Baumann
        </div>
        <h1>
          Hi! I'm Josh. <span class="jdb-cursor" aria-hidden="true"></span>
        </h1>
        <p class="jdb-hero__role">SEO Strategist • Data Enthusiast • Developer</p>
        <p class="jdb-hero__lede">
          I help businesses improve search visibility, data quality, and digital execution through thoughtful strategy, clean implementation, and practical experimentation.
        </p>
        <div class="jdb-hero__actions">
          <a href="/seo-helpline/" class="jdb-btn jdb-btn--primary jdb-btn--lg">Book a consultation</a>
          <a href="/blog/" class="jdb-btn jdb-btn--outline jdb-btn--lg">Read my writing</a>
        </div>
      </div>
    </div>
  </section>

  <Logos />

  <section class="jdb-section">
    <div class="jdb-container">
      <div class="jdb-section__head">
        <span class="jdb-eyebrow">what I do</span>
        <h2 class="jdb-section__title">Focused on the parts that move the needle</h2>
      </div>
      <div class="jdb-grid jdb-grid--2">
        <article class="jdb-service">
          <div class="jdb-service__icon"><span class="jdb-icon jdb-icon--search" aria-hidden="true"></span></div>
          <h3>SEO Strategy</h3>
          <p>Technical audits, keyword direction, content systems, and practical plans that improve visibility and quality.</p>
        </article>
        <article class="jdb-service">
          <div class="jdb-service__icon"><span class="jdb-icon jdb-icon--branch" aria-hidden="true"></span></div>
          <h3>Analytics &amp; Measurement</h3>
          <p>Google Analytics, Tag Manager, and reporting systems that help teams make better, faster decisions.</p>
        </article>
        <article class="jdb-service">
          <div class="jdb-service__icon"><span class="jdb-icon jdb-icon--check" aria-hidden="true"></span></div>
          <h3>Web Development</h3>
          <p>Clean, performant websites and tooling that support content, conversion, and sustainable growth.</p>
        </article>
        <article class="jdb-service">
          <div class="jdb-service__icon"><span class="jdb-icon jdb-icon--external" aria-hidden="true"></span></div>
          <h3>Programmatic SEO</h3>
          <p>Data-driven systems and automation ideas that let content teams scale with quality and control.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="jdb-section jdb-section--raised">
    <div class="jdb-container">
      <div class="jdb-section__head jdb-section__head--center">
        <span class="jdb-eyebrow">recent work</span>
        <h2 class="jdb-section__title">Featured writing</h2>
        <p class="jdb-section__sub">Notes on SEO, analytics, web development, and digital strategy.</p>
      </div>
      <div class="jdb-postgrid">
        {featuredPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <section class="jdb-section">
    <div class="jdb-container">
      <div class="jdb-section__head jdb-section__head--center">
        <span class="jdb-eyebrow">all posts</span>
        <h2 class="jdb-section__title">A full archive of ideas and experiments</h2>
      </div>
      <div class="jdb-postgrid">
        {posts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json">
    {JSON.stringify(pageSchema)}
  </script>

</BaseLayout>
