---
<BaseLayout seoTitle={seoTitle} description={description}>
  <nav slot="nav">
    <Navigation>
      <Search />
    </Navigation>
  </nav>

  <section class="section">
    <div class="container">
      <h1 class="title">Hello! I'm Josh!</h1>
      <p>Welcome to my personal site! I'm Josh, an SEO consultant and data enthusiast. I write about SEO, web analytics, and sometimes web development. Learn more about my work and how I can help your business.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Featured Articles</h2>
      <div class="columns is-multiline">
        {featuredPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
      <Logos />
    </div>
  </section>

  <section class="section">
    <div class="container has-text-centered">
      <a href="/seo-helpline/" class="button is-primary is-medium">Need SEO Help?</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h3 class="title is-4">All Articles</h3>
      <ul>
        {posts.map((post) => (
          <li><a href={post.url}>{post.title}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <script type="application/ld+json">
    {JSON.stringify(pageSchema)}
  </script>

  <Footer slot="footer" />
</BaseLayout>
