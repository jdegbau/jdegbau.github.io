      'inLanguage': 'en',
      'isPartOf': { '@id': 'https://jdegbau.com/#website' },
      'about': { '@id': 'https://jdegbau.com/#person' },
      'mainEntity': { '@id': 'https://jdegbau.com/#analytics-measurement-service' },
