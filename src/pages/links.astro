---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Search from '../components/Search.astro';
import Footer from '../components/Footer.astro';

const seoTitle = 'My Favorite Links';
const description = 'Curated links and useful resources from Joshua DeGrasse-Baumann.';
---
<BaseLayout seoTitle={seoTitle} description={description} noindex={true}>
  <nav slot="nav">
    <Navigation>
      <Search />
    </Navigation>
  </nav>

  <section class="jdb-hero jdb-hero--intro">
    <div class="jdb-container jdb-container--narrow">
      <span class="jdb-eyebrow">links</span>
      <h1>Joshua DeGrasse-Baumann</h1>
      <p class="jdb-hero__lede">A few of my favorite things, tools, and places to spend time online.</p>
    </div>
  </section>

  <section class="jdb-section">
    <div class="jdb-container jdb-container--narrow">
      <div class="jdb-stack">
        <a class="jdb-btn jdb-btn--outline jdb-btn--block" href="https://jdegbau.com" target="_blank" rel="noopener noreferrer">My Personal Website</a>
        <a class="jdb-btn jdb-btn--outline jdb-btn--block" href="https://bilt.page/r/URCB-UEF8" target="_blank" rel="noopener noreferrer">Bilt Credit Card</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
