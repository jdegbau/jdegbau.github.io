---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

const seoTitle = 'SEO Fetcher — quick on-page SEO checks';
const description = 'A lightweight Chrome extension for quick on-page SEO inspections and metadata fetching.';
---
<BaseLayout seoTitle={seoTitle} description={description}>
  <Hero variant="intro" containerWidth="narrow">
    <span class="jdb-eyebrow">tool</span>
    <h1>SEO Fetcher — Quick on-page SEO checks</h1>
    <p class="jdb-hero__lede">A lightweight Chrome extension for fast on-page SEO inspection and metadata fetching.</p>
  </Hero>

  <section class="jdb-section">
    <div class="jdb-container jdb-container--narrow">
      <div class="jdb-prose">
        <p><strong>SEO Fetcher</strong> surfaces important page-level signals without leaving the tab. It is built for SEOs, content editors, and developers who want a fast view of titles, meta descriptions, canonicals, headers, and more.</p>
        <p><a class="jdb-btn jdb-btn--primary" href="https://chromewebstore.google.com/detail/seo-fetcher/jebfcaafldnmfgdbfdijbajhdmdapfnc" target="_blank" rel="noopener">Install SEO Fetcher on Chrome</a></p>

        <h2>What it does</h2>
        <ul>
          <li><strong>Fetches page metadata:</strong> title, meta description, meta robots, canonical URL.</li>
          <li><strong>Shows key headers:</strong> H1 and H2 content found on the page.</li>
          <li><strong>Flags common issues:</strong> missing titles/descriptions, duplicate canonicals, or disallowed robots directives.</li>
          <li><strong>Copies values:</strong> quickly copy meta or header values for reporting and notes.</li>
        </ul>

        <h2>Why I made it</h2>
        <p>Sometimes you need a fast answer: does this page have a good title, is the canonical correct, or is it blocked from indexing? SEO Fetcher gives concise, copyable output so you can work faster during audits and content reviews.</p>

        <h2>Privacy &amp; permissions</h2>
        <p>The extension only reads the page you’re visiting to extract metadata and header text. It does not collect or transmit page content back to any server — all analysis happens locally in your browser.</p>

        <h2>Feedback</h2>
        <p>If you find bugs or have feature ideas, email me through the <a href="/contact/">contact page</a>.</p>
      </div>
    </div>
  </section>

</BaseLayout>
