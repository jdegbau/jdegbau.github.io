---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

const seoTitle = 'SEO Game';
const description = 'Redirecting to the SEO Game landing page.';
---
<BaseLayout seoTitle={seoTitle} description={description}>
  <Hero variant="intro" containerWidth="narrow">
    <div class="jdb-center">
      <span class="jdb-eyebrow">redirect</span>
      <h1>Redirecting to SEO Game</h1>
      <p class="jdb-hero__lede">If you are not redirected automatically, <a href="https://www.seogame.fun/lol/level8found200ok">click here</a>.</p>
    </div>
  </Hero>

  <script>
    window.location.replace('https://www.seogame.fun/lol/level8found200ok');
  </script>

</BaseLayout>
