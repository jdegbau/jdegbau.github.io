---
import BaseLayout from '../layouts/BaseLayout.astro';
import Logos from '../components/Logos.astro';
import Steps from '../components/Steps.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const seoTitle = 'Schedule a Call';
const description = 'Have an urgent SEO, content, or measurement question? Schedule a one-hour call with the SEO Helpline and get an expert consultation for just $100.';
const faq = [
  {
    question: 'Is this a sales call?',
    answer: 'No. It’s a working session focused on your question. There’s no retainer and no obligation to buy anything else.',
  },
  {
    question: 'Is it only for SEO questions?',
    answer: 'SEO is the most common topic, but content strategy, analytics, GA4 and Tag Manager tracking, measurement plans, and reporting questions are all welcome.',
  },
  {
    question: 'How should I prepare?',
    answer: 'Write down the question and the outcome you want, and gather any links, screenshots, or data that help explain it. Sharing them ahead of time lets us spend the hour on answers, not setup.',
  },
  {
    question: 'What if I need more than one call?',
    answer: 'You can book another session anytime, or <a href="/contact/">send a note</a> if you think you need ongoing help.',
  },
];
---
<BaseLayout seoTitle={seoTitle} description={description}>
  <section class="jdb-hero helpline-hero">
    <div class="jdb-container jdb-container--wide">
      <div class="helpline-hero__layout">
        <div class="helpline-hero__copy">
          <span class="jdb-eyebrow">seo helpline / one-to-one consulting</span>
          <h1>Get clear on your next SEO move.</h1>
          <p class="jdb-hero__lede">Bring the question you can’t quite solve. Leave with a sharper diagnosis and practical next steps.</p>
          <div class="jdb-hero__actions">
            <a class="jdb-btn jdb-btn--primary jdb-btn--lg" href="#booking">Choose a time</a>
            <a class="jdb-btn jdb-btn--ghost" href="/contact/">Ask a question first</a>
          </div>
        </div>

        <aside class="helpline-rate" aria-label="Consultation details">
          <span class="helpline-rate__label">a focused working session</span>
          <strong class="helpline-rate__price">$100</strong>
          <span class="helpline-rate__unit">per 60-minute call</span>
          <div class="helpline-rate__rule"></div>
          <p>Direct, practical guidance for SEO, content, and measurement questions. No retainer or ongoing commitment.</p>
        </aside>
      </div>
    </div>
  </section>

  <Logos />

  <section class="jdb-section jdb-section--raised">
    <div class="jdb-container jdb-container--wide">
      <div class="jdb-grid jdb-grid--2 helpline-details">
        <div>
          <span class="jdb-eyebrow">good fits for a call</span>
          <h2>Bring a specific question</h2>
          <ul class="helpline-topics">
            <li>Traffic dropped and you don’t know why</li>
            <li>A site migration or redesign is coming up</li>
            <li>You need a content plan or a second opinion on one</li>
            <li>Your GA4 or Tag Manager data doesn’t look right</li>
            <li>You need a report or dashboard that people will actually read</li>
          </ul>
        </div>
        <div>
          <span class="jdb-eyebrow">what to expect</span>
          <h2>How the session works</h2>
          <Steps label="How an SEO Helpline session works">
            <ol>
              <li><strong>Book a time below.</strong> Payment is handled when you book.</li>
              <li><strong>Share context ahead of time.</strong> Send your question, links, and any data you have.</li>
              <li><strong>Meet for an hour.</strong> We dig into the problem together and prioritize what to do.</li>
              <li><strong>Leave with next steps.</strong> You’ll know what to fix first and why.</li>
            </ol>
          </Steps>
        </div>
      </div>
    </div>
  </section>

  <section class="jdb-section helpline-booking" id="booking">
    <div class="jdb-container jdb-container--wide">
      <header class="helpline-booking__header">
        <div>
          <span class="jdb-eyebrow">book a session</span>
          <h2>Pick a time that works.</h2>
        </div>
        <p>Select an available slot below to book your session. If none are available, email <a href="mailto:josh@jdegbau.com">josh@jdegbau.com</a> and we can arrange a time.</p>
      </header>
      <div class="helpline-booking__embed">
        <div id="tidycal-embed" data-path="jdegbau/seo-helpline-consultation"></div>
      </div>
      <script src="https://asset-tidycal.b-cdn.net//js/embed.js"></script>
    </div>
  </section>

  <FAQAccordion items={faq} title="Questions before you book" eyebrow="faq" />

</BaseLayout>

<style>
  .helpline-hero { border-bottom: 1px solid var(--jdb-line); }

  .helpline-hero__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, .65fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 6rem);
  }

  .helpline-hero__copy h1 {
    max-width: 15ch;
    font-size: var(--jdb-fs-4xl);
  }

  .helpline-hero__copy .jdb-hero__lede { max-width: 55ch; }

  .helpline-rate {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--jdb-line-strong);
    border-top: 3px solid var(--jdb-orange-500);
    border-radius: var(--jdb-r-md);
    background: linear-gradient(145deg, rgba(21, 42, 73, .92), rgba(15, 31, 56, .82));
    box-shadow: var(--jdb-sh-md);
  }

  .helpline-rate__label,
  .helpline-rate__unit {
    display: block;
    color: var(--jdb-fg-muted);
    font-family: var(--jdb-font-mono);
    font-size: var(--jdb-fs-xs);
  }

  .helpline-rate__price {
    display: block;
    margin: var(--jdb-s-3) 0 0;
    color: var(--jdb-fg);
    font-family: var(--jdb-font-mono);
    font-size: 3.5rem;
    line-height: 1;
  }

  .helpline-rate__rule {
    height: 1px;
    margin: var(--jdb-s-5) 0;
    background: var(--jdb-line-strong);
  }

  .helpline-rate p { margin: 0; font-size: var(--jdb-fs-sm); }

  .helpline-details { gap: clamp(2rem, 5vw, 4rem); }
  .helpline-details h2 { font-size: var(--jdb-fs-2xl); }

  .helpline-topics {
    display: grid;
    gap: var(--jdb-s-3);
    margin: var(--jdb-s-5) 0 0;
    padding: 0;
    list-style: none;
    color: var(--jdb-fg-dim);
  }

  .helpline-topics li {
    display: flex;
    gap: var(--jdb-s-3);
    align-items: baseline;
  }

  .helpline-topics li::before {
    color: var(--jdb-good);
    content: '>';
    font-family: var(--jdb-font-mono);
  }

  .helpline-booking { scroll-margin-top: calc(var(--jdb-header-h) + var(--jdb-s-4)); }

  .helpline-booking__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--jdb-s-6);
    margin-bottom: var(--jdb-s-6);
  }

  .helpline-booking__header h2 { margin: 0; }
  .helpline-booking__header p { max-width: 38ch; margin: 0; }

  .helpline-booking__embed {
    overflow: hidden;
    border: 1px solid var(--jdb-line-strong);
    border-radius: var(--jdb-r-md);
    background: var(--jdb-navy-900);
    box-shadow: var(--jdb-sh-md);
  }

  @media (max-width: 52rem) {
    .helpline-hero__layout { grid-template-columns: 1fr; }
    .helpline-rate { max-width: 32rem; }
  }

  @media (max-width: 40rem) {
    .helpline-hero__copy h1 { font-size: var(--jdb-fs-3xl); }
    .helpline-booking__header { align-items: start; flex-direction: column; }
  }
</style>
