---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import Steps from '../../components/Steps.astro';

const seoTitle = 'Thanks for Scheduling!';
const description = 'Thanks for scheduling your consultation with Joshua DeGrasse-Baumann.';
---
<BaseLayout seoTitle={seoTitle} description={description} noindex={true}>
  <Hero variant="intro" containerWidth="narrow">
    <div class="jdb-center">
      <span class="jdb-eyebrow">you're booked</span>
      <h1>Looking forward to chatting!</h1>
      <p class="jdb-hero__lede">Thanks for scheduling your consultation. Here’s what happens between now and our call.</p>
    </div>
  </Hero>

  <section class="jdb-section jdb-section--tight">
    <div class="jdb-container jdb-container--narrow">
      <Steps label="What happens before your consultation">
        <ol>
          <li><strong>Check your inbox.</strong> Your booking confirmation should arrive by email shortly. I’ll also be in touch about next steps.</li>
          <li><strong>Send your question ahead of time.</strong> Email it, plus any helpful links or screenshots, to <a href="mailto:josh@jdegbau.com">josh@jdegbau.com</a> so we can spend the hour on answers instead of background.</li>
          <li><strong>Leave with next steps.</strong> You’ll finish the call with a clear diagnosis and a short list of what to do next.</li>
        </ol>
      </Steps>

      <div class="jdb-hero__actions thanks-actions">
        <a href="/blog/" class="jdb-btn jdb-btn--primary jdb-btn--lg">Read the guides while you wait</a>
        <a href="#newsletter" class="jdb-btn jdb-btn--outline jdb-btn--lg">Subscribe by email</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .thanks-actions { justify-content: center; }
</style>
