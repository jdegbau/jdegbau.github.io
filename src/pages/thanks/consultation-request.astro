---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';

const seoTitle = 'Thanks for Scheduling!';
const description = 'Thanks for scheduling your consultation with Joshua DeGrasse-Baumann.';
---
<BaseLayout seoTitle={seoTitle} description={description} noindex={true}>
  <Hero variant="intro" containerWidth="narrow">
    <div class="jdb-center">
      <span class="jdb-eyebrow">thanks</span>
      <h1>Looking forward to chatting!</h1>
      <p class="jdb-hero__lede">Thanks for scheduling your consultation. I’ll be in touch soon to discuss next steps.</p>
      <p>To get the most from our hour, send your question and any helpful links or screenshots to <a href="mailto:josh@jdegbau.com">josh@jdegbau.com</a> before the call.</p>
      <div class="jdb-hero__actions thanks-actions">
        <a href="/blog/" class="jdb-btn jdb-btn--primary jdb-btn--lg">Read the guides while you wait</a>
        <a href="#newsletter" class="jdb-btn jdb-btn--outline jdb-btn--lg">Subscribe by email</a>
        <a href="https://www.linkedin.com/in/jdegbau/" class="jdb-btn jdb-btn--ghost jdb-btn--lg" rel="noopener noreferrer">Connect on LinkedIn</a>
      </div>
    </div>
  </Hero>

</BaseLayout>

<style>
  .thanks-actions { justify-content: center; }
</style>
