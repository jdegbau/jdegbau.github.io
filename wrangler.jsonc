{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-28",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "jdegbau-site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// Serve the prerendered 404.html (from src/pages/404.astro) with a real
		// 404 status for any URL that doesn't match a static asset.
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}